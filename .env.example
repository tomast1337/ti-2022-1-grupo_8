# Postgres (used by docker-compose and by the backend when run outside Docker)
POSTGRES_USER=pizzaria
POSTGRES_PASSWORD=pizzaria
POSTGRES_DB=pizzaria
POSTGRES_PORT=5432
# Only used outside Docker; compose builds its own URL pointing at the db service
DATABASE_URL=postgres://pizzaria:pizzaria@localhost:5432/pizzaria

# Backend
BACKEND_PORT=3001
# Min 16 chars. Generate: node -e 'console.log(require("crypto").randomBytes(64).toString("hex"))'
JWT_SECRET=change-me-to-a-long-random-secret
# Comma separated list of allowed origins
CORS_ORIGIN=http://localhost:5173
# Where admin-uploaded images are stored (served at /uploads)
UPLOADS_DIR=./uploads
# Dev password for the seeded users (default: pizzaria123)
# SEED_PASSWORD=

# Frontend (Vite)
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3001

# Set to 1 on macOS/Windows if Docker file watching does not hot-reload
# CHOKIDAR_USEPOLLING=1
