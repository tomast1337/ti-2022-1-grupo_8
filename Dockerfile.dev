# Development image shared by the backend and frontend services.
# Source code is bind-mounted by docker-compose.yml; only dependencies live here.
FROM node:22-bookworm-slim

WORKDIR /app

# Copy manifests first so the dependency layer is cached until they change.
COPY package.json package-lock.json ./
COPY apps/backend/package.json apps/backend/
COPY apps/frontend/package.json apps/frontend/
COPY packages/dtos/package.json packages/dtos/

RUN npm ci

ENV NODE_ENV=development
